#!/bin/sh
# Maven Wrapper script for Unix-like systems
# Downloads Maven if not present, then runs it

set -e

# Find project base dir
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
export MAVEN_PROJECTBASEDIR

# Maven wrapper jar location
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Read distribution URL from properties
if [ -f "$WRAPPER_PROPERTIES" ]; then
    MAVEN_DOWNLOAD_URL=$(grep -oP '(?<=distributionUrl=).*' "$WRAPPER_PROPERTIES" 2>/dev/null || \
                         sed -n 's/distributionUrl=//p' "$WRAPPER_PROPERTIES")
fi

MAVEN_DOWNLOAD_URL="${MAVEN_DOWNLOAD_URL:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip}"

# Maven home
MAVEN_HOME="$MAVEN_PROJECTBASEDIR/.mvn/maven"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven..."
    mkdir -p "$MAVEN_HOME"
    TMPFILE=$(mktemp)
    curl -sL "$MAVEN_DOWNLOAD_URL" -o "$TMPFILE"
    unzip -q -o "$TMPFILE" -d "$MAVEN_HOME"
    rm "$TMPFILE"
    # Move extracted contents up one level
    EXTRACTED_DIR=$(ls "$MAVEN_HOME")
    mv "$MAVEN_HOME/$EXTRACTED_DIR"/* "$MAVEN_HOME/"
    rmdir "$MAVEN_HOME/$EXTRACTED_DIR"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
